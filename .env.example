DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Resend (https://resend.com) — para el correo de verificación al registrarse
RESEND_API_KEY="re_xxx"

# Opcional: remitente propio una vez verifiques un dominio en Resend.
# Sin esto, se usa "ANDES <onboarding@resend.dev>" (solo entrega correos al
# dueño de la cuenta de Resend mientras no haya un dominio verificado).
# RESEND_FROM_EMAIL="ANDES <no-reply@tudominio.com>"

# Opcional: dominio real en producción, para que el link del correo de
# verificación apunte al lugar correcto. Por defecto usa http://localhost:3000.
# APP_URL="https://tu-app.vercel.app"

# Pexels (https://www.pexels.com/api/) — para scripts/actualizar-imagenes-pexels.ts
PEXELS_API_KEY="xxx"

# Gemini (https://ai.google.dev/) — para el chatbot de atención al cliente
GEMINI_API_KEY="xxx"
